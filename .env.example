# Folder with kids/ and adults/ inside. Can be an external disk, e.g. /Volumes/Movies
MEDIA_PATH=./storage
# Port on the host
PORT=8080
# How many ffmpeg conversions may run at the same time
MAX_TRANSCODES=2
# Full library rescan interval in seconds (file events are also watched)
RESCAN_INTERVAL=60
# Password for watching from outside the home through a Cloudflare tunnel (not needed at home)
CINEHOME_PASSWORD=
